---
// 7. Example menus — clickable cards that open real client menus in a new tab.
// Data lives in src/data/menus.ts — edit there to add / reorder restaurants.

import { showcaseMenus } from '../data/menus';

// Les cartes vivent tout en bas de la page : on les sert en <img loading="lazy">
// plutôt qu'en background CSS, sinon les 6 photos sont téléchargées d'emblée et
// entrent en concurrence avec le héros. `auto=format` → AVIF/WebP côté Unsplash.
const coverWidths = [320, 480, 640, 800];
const coverSrc = (photo: string, w: number) =>
  `${photo}?auto=format&fit=crop&q=75&w=${w}&h=${Math.round((w * 4) / 3)}`;
const coverSizes =
  '(max-width: 620px) min(76vw, 300px), (max-width: 900px) calc((100vw - 78px) / 2), 360px';
const avatarSrc = (photo: string) =>
  `${photo}?auto=format&fit=crop&q=75&w=88&h=88`;
---

<section class="showcase section-pad" id="stories">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Exemples</span>
      <h2 class="section-title">Des menus déjà <i>en ligne.</i></h2>
      <p style="margin-top:18px;font-size:18px;color:var(--ink-2);max-width:560px;margin-left:auto;margin-right:auto;">
        Cliquez sur une carte pour ouvrir le vrai menu numérique de l'un de nos clients.
      </p>
    </div>

    <div class="menu-grid">
      {showcaseMenus.map((menu, i) => (
        <a
          class="menu-card reveal"
          data-delay={((i % 3) + 1).toString()}
          href={menu.href}
          target="_blank"
          rel="noopener"
        >
          <img
            class="cover"
            src={coverSrc(menu.hero, 480)}
            srcset={coverWidths.map((w) => `${coverSrc(menu.hero, w)} ${w}w`).join(', ')}
            sizes={coverSizes}
            alt=""
            width="480"
            height="640"
            loading="lazy"
            decoding="async"
          />
          <span class="badge"><span class="live"></span>Ouvert</span>
          <div class="info">
            <div class="who">
              {menu.avatar && (
                <img class="avatar" src={avatarSrc(menu.avatar)} alt="" loading="lazy" decoding="async" width="44" height="44" />
              )}
              <div>
                <h3>
                  {menu.name}
                  {menu.nameItalic && <> <i>{menu.nameItalic}</i></>}
                </h3>
                <div class="meta">
                  <span>{menu.city}</span>
                  <span class="dot"></span>
                  <span>{menu.cuisine}</span>
                </div>
              </div>
            </div>
            <span class="go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7" />
                <polyline points="7 7 17 7 17 17" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <p class="more reveal">
      <a href="#cta">Rejoignez-nous →</a>
    </p>
  </div>
</section>
