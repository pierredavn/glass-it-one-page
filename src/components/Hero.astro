---
// 1. Hero — full-bleed photo, glass pill, headline, CTAs, floating glass cards
import { REGISTER_URL } from '../urls';

// Photo plein cadre du héros. Servie en <img> (et non en background CSS) pour que
// le préchargeur HTML la découvre immédiatement, avec srcset pour ne pas envoyer
// 1900px de large à un téléphone. `auto=format` laisse Unsplash servir de l'AVIF/WebP.
const HERO_PHOTO = 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4';
// q=55 : l'image est floutée à 4px puis assombrie par le voile, la compression
// ne se voit pas — Lighthouse chiffrait 44 Ko de gaspillage à q=70.
const heroSrc = (w: number) => `${HERO_PHOTO}?auto=format&fit=crop&q=55&w=${w}`;
const heroWidths = [640, 800, 960, 1280, 1600, 1920];

// L'image est floutée à 4px et couverte d'un voile : la pleine densité de
// l'écran n'apporte rien de visible. On sous-déclare `sizes` sur mobile pour
// que le navigateur choisisse un cran plus bas (960px au lieu de 1280px sur un
// téléphone en DPR 3, soit ~60 ko de moins sur le chemin critique du LCP).
const heroSizes = '(max-width: 900px) 70vw, 100vw';
---

<section class="hero" data-screen-label="01 Hero">
  <img
    class="hero-bg"
    src={heroSrc(1280)}
    srcset={heroWidths.map((w) => `${heroSrc(w)} ${w}w`).join(', ')}
    sizes={heroSizes}
    alt=""
    aria-hidden="true"
    width="1280"
    height="853"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="hero-floats" aria-hidden="true">
    <div class="float-card fc-1">
      <div
        class="swatch"
        style="background-image:url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&q=75&w=112&h=112')"
      ></div>
      <div>
        <div style="font-weight:600">Burrata · 14€</div>
        <div style="color:#6B6B6B;font-size:11px">Ajouté à votre carte</div>
      </div>
    </div>

    <div class="float-card fc-2">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <path d="M14 14h3v3h-3zM20 14h1M17 20h1M14 21h1M20 17h1M19 19h2M20 21h1" />
      </svg>
      <div>
        <div style="font-weight:600">QR scanné · 1 247×</div>
        <div style="color:#6B6B6B;font-size:11px">cette semaine</div>
      </div>
    </div>

    <div class="float-card fc-3">
      <div style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#2D8A55,#7BC998);display:flex;align-items:center;justify-content:center;color:#fff">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </div>
      <div>
        <div style="font-weight:600">Menu publié</div>
        <div style="color:#6B6B6B;font-size:11px">Il y a 12 secondes</div>
      </div>
    </div>
  </div>

  <div class="hero-inner">
    <span class="pill"><span class="dot"></span>Nouveau · Menu numérique</span>
    <h1>Le menu qui<br />donne faim, avant<br />même d'arriver.</h1>
    <p class="lead">
      Glass It transforme la carte de votre bar ou restaurant en menu numérique moderne,
      accessible en 3 secondes via QR code.
    </p>
    <div class="hero-ctas">
      <a href={REGISTER_URL} class="btn btn-primary">
        Créer mon menu
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
      <a href="#demo" class="btn btn-glass">
        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg>
        Voir une démo
      </a>
    </div>
    <div class="reassure">
      <span class="dot"></span>Sans engagement · Installation en 5 min
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span>scroll</span>
    <span class="line"></span>
  </div>
</section>
