---
// 6. Pricing — Free, Premium & Multi-restaurants
import { REGISTER_URL } from '../urls';

const checkIcon = (color: string) => `
  <svg viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
`;

// Ce qui n'est pas inclus dans une formule : on l'affiche plutôt que de le
// passer sous silence, avec une croix pour ne pas le confondre avec un acquis.
const crossIcon = (color: string) => `
  <svg viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
  </svg>
`;

// Le paramètre ?checkout=... déclenche le checkout Stripe du plan choisi
// juste après l'inscription sur l'app. Le plan Free n'en a pas : rien à payer.
const plans = [
  {
    name: 'Free',
    price: '0€',
    period: 'pour toujours',
    tag: 'Votre carte en ligne, en version basique.',
    features: [
      'Articles illimités',
      'Catégories illimitées',
      'Nom et prix de chaque article',
      'Photo de couverture du menu',
    ],
    // Espaces insecables dans les guillemets pour eviter un « » orphelin en fin de ligne.
    limits: [
      'Pas de photo sur les articles',
      'Pas de personnalisation des couleurs',
      'Mention « Propulsé par Glass It » en bas du menu',
      'Logo Glass It à la place du vôtre',
    ],
    href: REGISTER_URL,
    cta: 'Créer mon menu gratuit',
    featured: false,
    // Bouton discret : l'offre payante reste l'appel à l'action principal.
    subtle: true,
  },
  {
    name: 'Premium',
    price: '10€',
    period: 'HT/mois',
    tag: "L'essentiel pour votre carte en ligne.",
    features: [
      'QR code dédié',
      'Un seul menu numérique',
      'Personnalisation (couleurs, logo)',
      'Mises à jour en temps réel',
    ],
    href: `${REGISTER_URL}?checkout=premium`,
    featured: false,
  },
  {
    name: 'Multi-restaurants',
    tag: 'Une offre pensée pour les groupes de restaurants.',
    features: [
      'Créez des menus pour plusieurs restaurants',
      'Plusieurs collaborateurs pour modifier le contenu',
      'Gestion des accès à un ou plusieurs menus',
      'Tout le plan Premium inclus',
    ],
    featured: true,
    // Offre pas encore commercialisée : on masque le prix et on désactive
    // l'inscription tant que la gestion multi-restaurants est en développement.
    comingSoon: true,
  },
];
---

<section class="pricing section-pad" id="pricing">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Tarifs</span>
      <h2 class="section-title">Simple, transparent, <i>sans surprise.</i></h2>
      <p class="section-sub">Commencez gratuitement, sans engagement. Changez ou résiliez quand vous voulez.</p>
    </div>

    <div class="price-grid">
      {plans.map((p) => (
        <div class={`price-card reveal${p.featured ? ' pro' : ''}`}>
          {p.comingSoon
            ? <div class="recommended-badge">Bientôt disponible</div>
            : p.featured && <div class="recommended-badge">Recommandé</div>}
          <div class="plan">{p.name}</div>
          {p.comingSoon
            ? <div class="amount coming-soon-price">Bientôt</div>
            : <div class="amount">{p.price}<span> {p.period}</span></div>}
          <div class="tag">{p.tag}</div>
          <ul>
            {p.features.map((f) => (
              <li>
                <Fragment set:html={checkIcon(p.featured ? '#FFFFFF' : '#1A1A1A')} />
                {f}
              </li>
            ))}
            {p.limits?.map((f) => (
              <li class="limit">
                <Fragment set:html={crossIcon('#B0AAA0')} />
                {f}
              </li>
            ))}
          </ul>
          {p.comingSoon
            ? <span class="btn btn-soon" aria-disabled="true">En cours de développement</span>
            : <a href={p.href} class={`btn ${p.subtle ? 'btn-outline' : 'btn-primary'}`}>{p.cta ?? 'Commencer'}</a>}
        </div>
      ))}
    </div>
  </div>
</section>
