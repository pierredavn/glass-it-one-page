---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Glass It, le menu qui donne faim',
  description = "Glass It transforme la carte de votre bar ou restaurant en menu numérique moderne, accessible en 3 secondes via QR code.",
} = Astro.props;

const site = Astro.site ?? 'https://glass-it.fr';
const canonical = new URL(Astro.url.pathname, site);

// Aperçu au partage (WhatsApp, LinkedIn, Slack, iMessage…). L'URL doit être
// absolue : c'est un serveur distant qui va la chercher, pas le navigateur.
// Les plateformes mettent cet aperçu en cache longtemps — pour le changer,
// renommer le fichier plutôt que de remplacer og.png en place.
const ogImage = new URL('/og.png', site);

// CSP portée par une balise <meta> plutôt qu'un en-tête, pour rester valable
// quel que soit l'hébergeur. `frame-ancestors`, impossible en <meta>, est
// ajoutée côté Vercel dans vercel.json.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  // Les composants utilisent des attributs style= inline (positions, images de fond).
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https://images.unsplash.com",
  "font-src 'self'",
  "connect-src 'self'",
  "form-action 'self'",
  "base-uri 'none'",
  "object-src 'none'",
].join('; ');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="theme-color" content="#F8F7F4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <title>{title}</title>

    <!-- Fonts : auto-hébergées, préchargées, non bloquantes -->
    <!-- Sans `crossorigin` : les photos sont chargées sans CORS, la connexion
         préétablie doit être celle-là pour être réutilisée. -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin.v17.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-latin.v40.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Glass It" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Glass It" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
  </head>
  <body>
    <slot />
    <CookieBanner />
  </body>
</html>
